// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
  binaryTargets   = ["native", "linux-musl-openssl-3.0.x", "linux-musl", "debian-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

// ─── ENUMS ───────────────────────────────────────────────────────────────────

enum Role {
  STUDENT
  INSTRUCTOR
  ADMIN
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum InstructorApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum CourseStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum CourseLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum LessonType {
  VIDEO
  PDF
  TEXT
}

enum EnrollmentStatus {
  ACTIVE
  COMPLETED
  DROPPED
}

enum MeetingStatus {
  PENDING_APPROVAL
  SCHEDULED
  LIVE
  ENDED
  CANCELLED
  REJECTED
}

enum AnnouncementTarget {
  ALL
  STUDENTS
  INSTRUCTORS
}

enum AnnouncementType {
  INFO
  WARNING
  ALERT
}

enum NotificationType {
  INFO
  SUCCESS
  WARNING
  ERROR
}

enum OTPPurpose {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

enum QuestionType {
  SINGLE_CHOICE
  MULTIPLE_CHOICE
  TRUE_FALSE
}

enum PaymentStatus {
  PENDING
  APPROVED
  REJECTED
}

enum PaymentMethodType {
  BANK_TRANSFER
  EASYPAISA
  JAZZCASH
}

enum SubmissionStatus {
  SUBMITTED
  REVIEWED
  GRADED
}

// ─── USER ────────────────────────────────────────────────────────────────────

model User {
  id                     String                   @id @default(uuid())
  name                   String
  fatherName             String?
  cnic                   String?                  @unique
  email                  String                   @unique
  password               String
  role                   Role                     @default(STUDENT)
  avatar                 String?
  bio                    String?
  phone                  String?
  dateOfBirth            DateTime?
  address                String?
  gender                 Gender?
  qualification          String?
  isVerified             Boolean                  @default(false)
  isActive               Boolean                  @default(true)
  // Instructor approval fields
  instructorApproval     InstructorApprovalStatus @default(APPROVED)
  instructorRejectedNote String?
  createdAt              DateTime                 @default(now())
  updatedAt              DateTime                 @updatedAt

  // Relations
  refreshTokens        RefreshToken[]
  enrollments          Enrollment[]
  certificates         Certificate[]
  notifications        Notification[]
  attendance           Attendance[]
  otpVerifications     OTPVerification[]
  quizAttempts         QuizAttempt[]
  quizSessions         QuizSession[]
  platformAnnouncements PlatformAnnouncement[] @relation("AdminAnnouncements")
  reviews              Review[]               @relation("StudentReviews")
  receivedReviews      Review[]               @relation("InstructorReviews")
  paymentRequests      PaymentRequest[]       @relation("StudentPayments")

  // Instructor specific
  courses         Course[]         @relation("InstructorCourses")
  zoomMeetings    ZoomMeeting[]    @relation("InstructorMeetings")
  announcements   Announcement[]   @relation("AuthoredAnnouncements")
  lessonProgress  LessonProgress[]
  assignedAssignments Assignment[]  @relation("InstructorAssignments")
  submissions     AssignmentSubmission[] @relation("StudentSubmissions")

  // Zoom OAuth (per-instructor credentials)
  zoomAccessToken    String?   // Short-lived OAuth access token
  zoomRefreshToken   String?   // Long-lived refresh token
  zoomTokenExpiresAt DateTime? // When the access token expires
  zoomUserId         String?   // Zoom user ID (from /v2/users/me)
  zoomEmail          String?   // Zoom account email (for display)
  zoomConnected      Boolean   @default(false)

  @@index([email])
  @@index([role])
  @@map("users")
}

// ─── REFRESH TOKEN ───────────────────────────────────────────────────────────

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@map("refresh_tokens")
}

// ─── OTP VERIFICATION ────────────────────────────────────────────────────────

model OTPVerification {
  id        String     @id @default(uuid())
  email     String
  otp       String
  purpose   OTPPurpose
  expiresAt DateTime
  userId    String?
  createdAt DateTime   @default(now())

  user      User?      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([email])
  @@index([otp])
  @@map("otp_verifications")
}

// ─── CATEGORY ────────────────────────────────────────────────────────────────

model Category {
  id          String   @id @default(uuid())
  name        String   @unique
  slug        String   @unique
  description String?
  icon        String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  courses     Course[]

  @@index([slug])
  @@map("categories")
}

// ─── COURSE ──────────────────────────────────────────────────────────────────

model Course {
  id               String       @id @default(uuid())
  title            String
  slug             String       @unique
  description      String
  shortDescription String?
  thumbnail        String?
  categoryId       String
  instructorId     String
  status           CourseStatus @default(DRAFT)
  level            CourseLevel  @default(BEGINNER)
  price            Decimal      @default(0) @db.Decimal(10, 2)
  isFree           Boolean      @default(true)
  duration         Int?         // Total duration in minutes
  durationInMonths Int          @default(2) // 2, 4, or 6 months
  totalLessons     Int          @default(0)
  learningOutcomes String[]
  prerequisites    String[]
  language         String       @default("English")
  certificate      Boolean      @default(true)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  pendingApproval  Boolean      @default(false)
  pendingEdits     Json?

  category         Category     @relation(fields: [categoryId], references: [id])
  instructor       User         @relation("InstructorCourses", fields: [instructorId], references: [id])
  modules          Module[]
  enrollments      Enrollment[]
  zoomMeetings     ZoomMeeting[]
  announcements    Announcement[]
  certificates     Certificate[]
  resources        Resource[]
  reviews          Review[]
  paymentRequests  PaymentRequest[]
  assignments      Assignment[]
  quiz             Quiz?        @relation("CourseQuiz")

  @@index([slug])
  @@index([categoryId])
  @@index([instructorId])
  @@index([status])
  @@map("courses")
}

// ─── MODULE ──────────────────────────────────────────────────────────────────

model Module {
  id          String   @id @default(uuid())
  title       String
  description String?
  courseId    String
  order       Int
  isPublished Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  course      Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessons     Lesson[]
  quiz        Quiz?    @relation("ModuleQuiz")

  @@index([courseId])
  @@map("modules")
}

// ─── LESSON ──────────────────────────────────────────────────────────────────

model Lesson {
  id          String     @id @default(uuid())
  title       String
  description String?
  moduleId    String
  type        LessonType @default(VIDEO)
  content     String?    // Text content or embed URL
  videoUrl    String?
  duration    Int?       // Duration in seconds
  order       Int
  isFree      Boolean    @default(false)
  isPublished Boolean    @default(false)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  module      Module     @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  resources   Resource[]
  progress    LessonProgress[]

  @@index([moduleId])
  @@map("lessons")
}

// ─── RESOURCE ────────────────────────────────────────────────────────────────

model Resource {
  id        String   @id @default(uuid())
  name      String
  fileUrl   String
  fileType  String
  fileSize  Int?
  lessonId  String?
  courseId  String?
  createdAt DateTime @default(now())

  lesson    Lesson?  @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  course    Course?  @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@index([lessonId])
  @@index([courseId])
  @@map("resources")
}

// ─── ENROLLMENT ──────────────────────────────────────────────────────────────

model Enrollment {
  id          String           @id @default(uuid())
  studentId   String
  courseId    String
  rollNumber          String?          @unique // e.g. SST-2026-00000001, assigned at enrollment time
  status              EnrollmentStatus @default(ACTIVE)
  progress            Float            @default(0) // Percentage 0-100
  certificateEligible Boolean?         // null = dynamic/automatic, true = admin granted, false = admin revoked
  enrolledAt          DateTime         @default(now())
  completedAt DateTime?
  updatedAt   DateTime         @updatedAt

  student        User             @relation(fields: [studentId], references: [id], onDelete: Cascade)
  course         Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessonProgress LessonProgress[]

  @@unique([studentId, courseId])
  @@index([studentId])
  @@index([courseId])
  @@index([rollNumber])
  @@map("enrollments")
}

// ─── LESSON PROGRESS ─────────────────────────────────────────────────────────

model LessonProgress {
  id             String     @id @default(uuid())
  enrollmentId   String
  lessonId       String
  userId         String
  isCompleted    Boolean    @default(false)
  watchedSeconds Int        @default(0)
  completedAt    DateTime?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  enrollment     Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  lesson         Lesson     @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  user           User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([enrollmentId, lessonId])
  @@index([enrollmentId])
  @@index([lessonId])
  @@map("lesson_progress")
}

// ─── QUIZ ─────────────────────────────────────────────────────────────────────

model Quiz {
  id               String       @id @default(uuid())
  courseId         String       @unique  // Course-level final assessment quiz
  moduleId         String?      @unique  // Optional module-level quiz (unused currently)
  title            String
  description      String?
  passMark         Int          @default(60) // Percentage required to pass
  timePerQuestion  Int          @default(60) // Seconds per question (client + server enforced)
  maxAttempts      Int          @default(3)  // Maximum attempts allowed
  isPublished      Boolean      @default(false) // Controls student visibility
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  course           Course?      @relation("CourseQuiz", fields: [courseId], references: [id], onDelete: Cascade)
  module           Module?      @relation("ModuleQuiz", fields: [moduleId], references: [id], onDelete: Cascade)
  questions        QuizQuestion[]
  attempts         QuizAttempt[]
  sessions         QuizSession[]

  @@index([courseId])
  @@index([moduleId])
  @@map("quizzes")
}

model QuizQuestion {
  id            String       @id @default(uuid())
  quizId        String
  question      String
  type          QuestionType @default(SINGLE_CHOICE)
  options       Json         // Array of { id, text } objects
  correctAnswer Json         // Array of correct option IDs
  explanation   String?
  order         Int
  createdAt     DateTime     @default(now())

  quiz          Quiz         @relation(fields: [quizId], references: [id], onDelete: Cascade)

  @@index([quizId])
  @@map("quiz_questions")
}

model QuizAttempt {
  id              String    @id @default(uuid())
  quizId          String
  userId          String
  attemptNumber   Int       // Sequential attempt number per student per quiz
  answers         Json      @default("{}") // { questionId: selectedOptionId }
  currentQuestion Int       @default(0)   // 0-based index of current question (for resume)
  score           Float     @default(0)   // Quiz percentage (0-100) — for pass/fail check
  rawScore        Float     @default(0)   // Number of correct answers
  mcqMarks        Float     @default(0)   // (rawScore/totalQuestions)*60 — final MCQ marks
  passed          Boolean   @default(false)
  timeTaken       Int?                    // Total seconds from start to submit
  startedAt       DateTime  @default(now())
  completedAt     DateTime?               // null = in-progress; set when submitted

  quiz            Quiz      @relation(fields: [quizId], references: [id], onDelete: Cascade)
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  session         QuizSession?

  @@index([quizId])
  @@index([userId])
  @@map("quiz_attempts")
}

// Tracks the active quiz window for timer enforcement and question sequencing
model QuizSession {
  id              String      @id @default(uuid())
  quizId          String
  userId          String
  attemptId       String      @unique    // Links to the in-progress QuizAttempt
  expiresAt       DateTime               // startedAt + (totalQuestions * timePerQuestion) + grace
  createdAt       DateTime    @default(now())

  quiz            Quiz        @relation(fields: [quizId], references: [id], onDelete: Cascade)
  user            User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  attempt         QuizAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)

  @@unique([quizId, userId]) // Only one active session per student per quiz
  @@index([quizId])
  @@index([userId])
  @@map("quiz_sessions")
}

// ─── ZOOM MEETING ─────────────────────────────────────────────────────────────

model ZoomMeeting {
  id           String        @id @default(uuid())
  courseId     String
  instructorId String
  meetingId    String?       @unique
  topic        String
  agenda       String?
  startTime    DateTime
  duration     Int           // Duration in minutes
  joinUrl      String?
  startUrl     String?
  password     String?
  status       MeetingStatus @default(PENDING_APPROVAL)
  rejectedNote String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  course       Course        @relation(fields: [courseId], references: [id], onDelete: Cascade)
  instructor   User          @relation("InstructorMeetings", fields: [instructorId], references: [id])
  attendance   Attendance[]

  @@index([courseId])
  @@index([instructorId])
  @@index([status])
  @@map("zoom_meetings")
}

// ─── ATTENDANCE ──────────────────────────────────────────────────────────────

model Attendance {
  id        String      @id @default(uuid())
  meetingId String
  studentId String
  joinedAt  DateTime    @default(now())
  leftAt    DateTime?
  duration  Int?        // Duration in minutes

  meeting   ZoomMeeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  student   User        @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([meetingId, studentId])
  @@index([meetingId])
  @@index([studentId])
  @@map("attendance")
}

// ─── CERTIFICATE ─────────────────────────────────────────────────────────────

model Certificate {
  id               String   @id @default(uuid())
  certificateId    String   @unique // e.g. SST-2026-00012345
  studentId        String
  courseId         String
  issuedAt         DateTime @default(now())
  certificateUrl   String?
  verificationCode String   @unique @default(uuid())

  // Marks breakdown stored at issuance time
  attendanceMarks  Float    @default(0) // out of 20
  assignmentMarks  Float    @default(0) // out of 20
  mcqMarks         Float    @default(0) // out of 60
  finalMarks       Float    @default(0) // total out of 100

  student          User     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  course           Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([studentId, courseId])
  @@index([studentId])
  @@index([courseId])
  @@index([certificateId])
  @@index([verificationCode])
  @@map("certificates")
}

// ─── PLATFORM ANNOUNCEMENT ───────────────────────────────────────────────────

model PlatformAnnouncement {
  id         String           @id @default(uuid())
  title      String
  body       String
  type       AnnouncementType @default(INFO)
  target     AnnouncementTarget @default(ALL)
  isActive   Boolean          @default(true)
  authorId   String
  expiresAt  DateTime?
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  author     User             @relation("AdminAnnouncements", fields: [authorId], references: [id])

  @@index([isActive])
  @@index([authorId])
  @@map("platform_announcements")
}

// ─── ANNOUNCEMENT (course-level) ─────────────────────────────────────────────

model Announcement {
  id          String             @id @default(uuid())
  title       String
  body        String
  authorId    String
  courseId    String?            // null = platform-wide
  targetRole  AnnouncementTarget @default(ALL)
  isPublished Boolean            @default(false)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  author      User               @relation("AuthoredAnnouncements", fields: [authorId], references: [id])
  course      Course?            @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@index([authorId])
  @@index([courseId])
  @@index([isPublished])
  @@map("announcements")
}

// ─── NOTIFICATION ────────────────────────────────────────────────────────────

model Notification {
  id        String           @id @default(uuid())
  userId    String
  title     String
  message   String
  type      NotificationType @default(INFO)
  isRead    Boolean          @default(false)
  link      String?
  createdAt DateTime         @default(now())

  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isRead])
  @@map("notifications")
}

// ─── REVIEW ──────────────────────────────────────────────────────────────────

model Review {
  id           String   @id @default(uuid())
  rating       Int      // 1 to 5
  comment      String
  studentId    String
  courseId     String?
  instructorId String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  student    User    @relation("StudentReviews", fields: [studentId], references: [id], onDelete: Cascade)
  course     Course? @relation(fields: [courseId], references: [id], onDelete: Cascade)
  instructor User?   @relation("InstructorReviews", fields: [instructorId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@index([courseId])
  @@index([instructorId])
  @@map("reviews")
}

// ─── PAYMENT METHOD ───────────────────────────────────────────────────────────

model PaymentMethod {
  id            String            @id @default(uuid())
  type          PaymentMethodType
  title         String            // e.g. "Meezan Bank", "Easypaisa"
  accountName   String
  accountNumber String
  instructions  String?           // Extra instructions for students
  isActive      Boolean           @default(true)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@map("payment_methods")
}

// ─── PAYMENT REQUEST ──────────────────────────────────────────────────────────

model PaymentRequest {
  id              String        @id @default(uuid())
  studentId       String
  courseId        String
  amount          Decimal       @db.Decimal(10, 2)
  screenshotUrl   String        // Uploaded proof of payment
  transactionRef  String?       // Optional transaction ID from student
  status          PaymentStatus @default(PENDING)
  rejectedNote    String?
  reviewedAt      DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  student  User   @relation("StudentPayments",  fields: [studentId], references: [id], onDelete: Cascade)
  course   Course @relation(fields: [courseId],  references: [id],   onDelete: Cascade)

  @@unique([studentId, courseId])
  @@index([studentId])
  @@index([courseId])
  @@index([status])
  @@map("payment_requests")
}

// ─── ASSIGNMENT ───────────────────────────────────────────────────────────────

model Assignment {
  id           String   @id @default(uuid())
  courseId     String
  instructorId String
  title        String
  description  String?
  fileUrl      String?          // Instructor's assignment file (any type)
  fileType     String?
  fileName     String?
  dueDate      DateTime?
  isPublished  Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  course       Course               @relation(fields: [courseId], references: [id], onDelete: Cascade)
  instructor   User                 @relation("InstructorAssignments", fields: [instructorId], references: [id])
  submissions  AssignmentSubmission[]

  @@index([courseId])
  @@index([instructorId])
  @@map("assignments")
}

// ─── ASSIGNMENT SUBMISSION ────────────────────────────────────────────────────

model AssignmentSubmission {
  id           String           @id @default(uuid())
  assignmentId String
  studentId    String
  fileUrl      String           // Student's submitted file
  fileType     String?
  fileName     String?
  note         String?
  status       SubmissionStatus @default(SUBMITTED)
  grade        String?          // Optional grading by instructor
  feedback     String?          // Optional instructor feedback
  submittedAt  DateTime         @default(now())
  reviewedAt   DateTime?

  assignment   Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  student      User       @relation("StudentSubmissions", fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([assignmentId, studentId])
  @@index([assignmentId])
  @@index([studentId])
  @@map("assignment_submissions")
}
